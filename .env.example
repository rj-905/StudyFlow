# StudyFlow — Required API Keys
# Copy this file to .env and fill in your keys.

# Google AI Studio API Key (Gemini models + text-embedding-004)
# Get it at: https://aistudio.google.com/apikey
GOOGLE_API_KEY="enter your google API Key"

# YouTube Data API v3 Key
# Get it at: https://console.cloud.google.com → APIs & Services → Enable YouTube Data API v3
YOUTUBE_API_KEY="your_API"

# Google Programmable Search Engine ID
# Get it at: https://programmablesearchengine.google.com → Create → Copy Search Engine ID
GOOGLE_CSE_ID="API_Key"
